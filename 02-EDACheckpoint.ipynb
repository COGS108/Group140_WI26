   "source": [
    "## YOUR CODE TO LOAD/CLEAN/TIDY/WRANGLE THE DATA GOES HERE\n",
    "## FEEL FREE TO ADD MULTIPLE CELLS PER SECTION \n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import os\n",
    "\n",
    "df_raw = pd.read_csv('data/00-raw/vgsales.csv')\n",
    "\n",
    "df_raw.head()\n",
    "\n",
    "# Cleaning Missing Values\n",
    "\n",
    "print(\"Before cleaning:\", df_raw.shape)\n",
    "\n",
    "df_clean = df_raw.dropna(subset=[\"Year\", \"Publisher\"])\n",
    "\n",
    "print(\"After cleaning:\", df_clean.shape)\n",
    "\n",
    "# Confirm the result is good\n",
    "print(\"\\nRemaining missing values:\")\n",
    "print(df_clean.isna().sum())\n",
    "\n",
    "# Select Relevant Variables\n",
    "\n",
    "selected_columns = [\n",
    "    \"Year\",\n",
    "    \"Platform\",\n",
    "    \"Genre\",\n",
    "    \"Publisher\",\n",
    "    \"Global_Sales\"\n",
    "]\n",
    "\n",
    "df_model = df_clean[selected_columns].copy()\n",
    "\n",
    "print(\"Model dataset shape:\", df_model.shape)\n",
    "df_model.head()\n",
    "\n",
    "# Year-normalized percentile\n",
    "\n",
    "df_model[\"Sales_Percentile\"] = (\n",
    "    df_model\n",
    "    .groupby(\"Year\")[\"Global_Sales\"]\n",
    "    .rank(pct=True)\n",
    ")\n",
    "\n",
    "df_model.head()\n",
    "\n",
    "# Create Bestseller Levels\n",
    "\n",
    "def classify_bestseller(p):\n",
    "    if p >= 0.90:\n",
    "        return \"Top 10%\"\n",
    "    elif p >= 0.75:\n",
    "        return \"75–90%\"\n",
    "    elif p >= 0.25:\n",
    "        return \"25–75%\"\n",
    "    else:\n",
    "        return \"Bottom 25%\"\n",
    "\n",
    "df_model[\"Bestseller_Level\"] = df_model[\"Sales_Percentile\"].apply(classify_bestseller)\n",
    "\n",
    "df_model.head()\n",
    "\n",
    "# Save Processed Dataset\n",
    "\n",
    "os.makedirs(\"data/02-processed\", exist_ok=True)\n",
    "df_model.to_csv(\"data/02-processed/video_game_model_data.csv\", index=False)"
   ]
